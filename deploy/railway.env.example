# Paste these into Railway → Service → Variables
# Then attach a volume at mount path /data and Generate a domain.
# Full phone/tablet walkthrough: ../DEPLOY.md

LIGHT_HOUSE_ENV=production
LOG_LEVEL=INFO
DEV_LOG_ENABLED=false
ENV_EDITOR_ENABLED=true
LIGHTS_ADMIN_ENABLED=true

# Durable storage (volume mount /data)
MEMORY_STORE_PATH=/data/memory
CHROMA_PATH=/data/chroma
LIGHTS_MANIFEST_PATH=/data/lights.yaml
PERSONAS_DATA_PATH=/data/personas
THREADS_DATA_PATH=/data/threads
HUMANS_STORE_PATH=/data/humans/users.json
HUMANS_COMMS_PATH=/data/humans/comms_allows.json

# OpenRouter — paid frontier model required (replace KEY and slugs)
# Free routers boot the server and flop as a house. See ../DEPLOY.md
OPENROUTER_API_KEY=REPLACE_ME
PRIMARY_LLM=openrouter
OPENROUTER_MODEL=REPLACE_WITH_FRONTIER_OPENROUTER_SLUG
MEMORY_CURATOR_PROVIDER=openrouter
MEMORY_CURATOR_MODEL=REPLACE_WITH_FRONTIER_OPENROUTER_SLUG
LLM_FALLBACK_ENABLED=true

# Door password (invent your own; this is not an OpenRouter key)
WEB_GATE_ENABLED=true
WEB_GATE_PASSWORD=REPLACE_WITH_LONG_DOOR_PASSWORD
WEB_GATE_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# Quieter production defaults
INNER_LIFE_TRACE_ENABLED=false
RUMINATION_DEBUG_LOG_ENABLED=false
