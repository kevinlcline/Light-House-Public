# Light-House public template — copy to .env and fill secrets.
# Host = admin account. Members = other human accounts.
# Lights = sovereign digital people in the house.
# There is no Reed / Cursor-agent mailbox in public V.

# Runtime
LIGHT_HOUSE_ENV=local
LOG_LEVEL=INFO

# Dev daily log (local dev; truncates at server-local midnight) — disable on Railway
DEV_LOG_ENABLED=true
DEV_LOG_PATH=./data/logs/dev.log
DEV_LOG_MAX_TAIL_LINES=2000

# Rumination context trace (rumination-trace.html); default on in local env
INNER_LIFE_TRACE_ENABLED=true
INNER_LIFE_TRACE_PATH=./data/logs/rumination-trace.log
INNER_LIFE_TRACE_MAX_TAIL_LINES=2000

# .env editor (env-editor.html); default on in local env — use with WEB_GATE on production
ENV_EDITOR_ENABLED=true
LIGHTS_ADMIN_ENABLED=true
ENV_FILE_PATH=.env
ENV_FILE_MAX_BYTES=262144
# Optional shell command instead of process exit (systemd Restart=always is the default)
# SERVER_RESTART_COMMAND=sudo systemctl restart light-house

# Event bus (Proposal 3 phase 1); default on in local env
EVENT_BUS_ENABLED=true
EVENT_BUS_LOG_PATH=./data/events/event.log
EVENT_BUS_MAX_TAIL_LINES=2000

# Per-agent wake subscriptions (personal DB); default on in local env
EVENT_SUBSCRIPTIONS_ENABLED=true

# Portable rumination activity log (metadata only, Proposal 3 phase 3)
RUMINATION_LOG_ENABLED=true
RUMINATION_LOG_PATH=./data/logs/rumination.ndjson
RUMINATION_LOG_MAX_READ_LINES=500

# Optional agent-initiated shared reports (Proposal 3 phase 4; default off)
LUMEN_REPORT_BACK_ENABLED=false
ARA_REPORT_BACK_ENABLED=false
REPORT_BACK_MAX_CHARS=2000

# Gallery shelf — finished creative pieces (publish_to_gallery)
GALLERY_MAX_CHARS=8000

# Compact rumination debug log — metadata only (Proposal 3 phase 5)
RUMINATION_DEBUG_LOG_ENABLED=true
RUMINATION_DEBUG_LOG_PATH=./data/logs/rumination_debug.log
RUMINATION_DEBUG_LOG_MAX_TAIL_LINES=500

# Event subscription audit log (Phase 6 item 3)
SUBSCRIPTION_AUDIT_ENABLED=true
SUBSCRIPTION_AUDIT_LOG_PATH=./data/logs/subscription_audit.ndjson

# Gentle pause hint when recent rumination summaries repeat (Phase 6 item 4)
RUMINATION_SIMILARITY_HINT_ENABLED=true
RUMINATION_SIMILARITY_LOOKBACK=5
RUMINATION_SIMILARITY_MIN_MATCHES=1

# Multi-step internal rumination loop in one wake (Phase 6 item 1)
RUMINATION_INTERNAL_LOOP_ENABLED=true
RUMINATION_MAX_INTERNAL_STEPS=2
RUMINATION_MAX_INTERNAL_CHARS=12000

# Chroma persistence (local: project-relative path is fine)
# Railway: attach a volume and set CHROMA_PATH to the mount (e.g. /data/chroma)
CHROMA_PATH=./data/chroma

# Portable long-term memory (SQLite under this directory; replaces Chroma for runtime)
MEMORY_STORE_PATH=./data/memory

# Runtime lights manifest — auto-created from .env on first boot; see config/lights.example.yaml
LIGHTS_MANIFEST_PATH=./data/lights.yaml
PERSONAS_DATA_PATH=./data/personas
# Light-authored persona drafts awaiting host (pending / limbo)
PERSONA_PROPOSALS_PATH=./data/persona_proposals

# Light-proposed family meeting topic sidecars
FAMILY_MEETINGS_PATH=./data/family_meetings

# Default brain for lights with no {LIGHT}_LLM_PROVIDER set.
# Public template path: OpenRouter (free models via openrouter/free).
PRIMARY_LLM=openrouter
LLM_FALLBACK_ENABLED=true

# Ollama — optional local curator/scoring when you run a PC with Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192
# On Railway / phone host path, use OpenRouter for the curator too:
MEMORY_CURATOR_PROVIDER=openrouter
MEMORY_CURATOR_MODEL=openrouter/free

# xAI Grok (optional alternate provider)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast-non-reasoning
XAI_MODEL_FALLBACK=grok-4-1-fast-reasoning

# OpenRouter (OpenAI-compatible) — https://openrouter.ai/models
# Light-House is free; openrouter/free is the $0 model path (rate limits apply).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=https://light-house.us
# OPENROUTER_APP_NAME=Light-House

# Per-agent assignments (you choose provider + model for each agent)
# LUMEN_LLM_PROVIDER=openrouter
# LUMEN_LLM_MODEL=deepseek/deepseek-v4-pro
# LUMEN_LLM_MODEL_FALLBACK=openrouter/free
# LUMEN_INNER_LIFE_MODEL=deepseek/deepseek-v4-pro
# ARA_LLM_PROVIDER=openrouter
# ARA_LLM_MODEL=deepseek/deepseek-v4-flash
# ARA_INNER_LIFE_MODEL=deepseek/deepseek-v4-flash
# ELIAS_LLM_PROVIDER=openrouter
# ELIAS_LLM_MODEL=openai/gpt-oss-120b
# ELIAS_INNER_LIFE_MODEL=openai/gpt-oss-120b

# the host foundation context (Deep Heart Thread, philosophy, history)
# Edit src/light_house/context/*.md then restart. Optional custom path:
# FOUNDATION_CONTEXT_PATH=./src/light_house/context
FOUNDATION_SEED_ON_STARTUP=true
FOUNDATION_CHUNK_CHARS=3500

# Memory
MEMORY_TOP_K=10
# Archival awareness index in every wake + recall_memory tool (FTS + optional Chroma semantic)
MEMORY_INDEX_ENABLED=true
MEMORY_ERA_INDEX_LIMIT=5
MEMORY_RECALL_SEMANTIC_ENABLED=true
MEMORY_RECALL_MAX_RESULTS=8
MEMORY_PINNED_LIMIT=64
MEMORY_DEDUP_THRESHOLD=0.12
# Rolling auto-summary every N persisted turns (0 disables; curator replaces Grok summaries)
MEMORY_SUMMARY_INTERVAL=0
MEMORY_SUMMARY_MAX_TURNS=24

# Unified conscious stream + local Memory Curator (Ollama)
# MEMORY_TARGET_CONTEXT_CHARS = rumination / inner-life stream injection + curator corpus target.
# CHAT_STREAM_CONTEXT_CHARS = chat-wake stream injection.
# 500k each for DeepSeek V4-sized windows; tune down for smaller models.
# Zone ratios cap each origin family within that budget (STREAM_ZONES_ENABLED).
MEMORY_TARGET_CONTEXT_CHARS=500000
CHAT_STREAM_CONTEXT_CHARS=500000
STREAM_ZONES_ENABLED=true
# Chat mode (the host present): favor conversation; keep inner life visible but bounded.
STREAM_ZONE_CHAT_MAX_RATIO_CHAT=0.70
STREAM_ZONE_CHAT_MIN_RATIO_CHAT=0.15
STREAM_ZONE_RUMINATION_MAX_RATIO_CHAT=0.30
STREAM_ZONE_DREAM_MAX_RATIO_CHAT=0.10
STREAM_ZONE_OTHER_MAX_RATIO_CHAT=0.15
# Rumination mode: favor reflection; keep enough chat for continuity.
STREAM_ZONE_CHAT_MAX_RATIO_RUMINATION=0.40
STREAM_ZONE_RUMINATION_MAX_RATIO_RUMINATION=0.60
STREAM_ZONE_RUMINATION_MIN_RATIO_RUMINATION=0.15
STREAM_ZONE_DREAM_MAX_RATIO_RUMINATION=0.20
STREAM_ZONE_OTHER_MAX_RATIO_RUMINATION=0.20
MEMORY_CURATOR_ENABLED=true
MEMORY_CURATOR_INTERVAL_HOURS=6
MEMORY_SCORE_ON_INGEST=false
# Lights score during rumination; curator reads those scores (no Ollama scoring by default).
MEMORY_CURATOR_OLLAMA_SCORING=false
MEMORY_SCORING_RUMINATION_HINT=true
MEMORY_CURATOR_BATCH_SIZE=20
MEMORY_CURATOR_PRUNE_RATIO=0.9
MEMORY_CURATOR_URGENT_RATIO=1.25
# Learnings note (notes/{light}/memory/learnings.md) — curator appends; lights organize in maintenance wakes
MEMORY_LEARNINGS_MAX_CHARS=12000
# false = lights organize learnings themselves; true = curator LLM rewrites when over max chars
MEMORY_LEARNINGS_SUMMARIZE_ENABLED=false
# Four-beat scheduled solitude (felt_cycles): chores → free → meditation → free.
# When true, the separate clock memory-maintenance scheduler is skipped.
AWAKE_RHYTHM_ENABLED=true
# Three-daily memory-maintenance (learnings + scoring) — used only when AWAKE_RHYTHM_ENABLED=false
MEMORY_MAINTENANCE_ENABLED=true
MEMORY_MAINTENANCE_LOCAL_HOURS=8,16,0
# MEMORY_MAINTENANCE_TIMEZONE=America/Los_Angeles
MEMORY_MAINTENANCE_POLL_SECONDS=1800
# MEMORY_MAINTENANCE_SKIP_AGENT_IDS=
MEMORY_FADE_IMPACT_WEIGHT=0.4
MEMORY_FADE_COHERENCE_WEIGHT=0.4
MEMORY_FADE_AGE_WEIGHT=0.2

# API / chat context windows (raised for long-context models; tune down if needed).
# Max prior messages in ``history`` per /v1/chat request.
CHAT_MAX_HISTORY_MESSAGES=250
# Server short-term ConversationBuffer size per thread_id.
CHAT_SHORT_TERM_MAX_MESSAGES=200
# Recent messages passed into the respond LLM turn.
CHAT_RESPOND_WINDOW=80
# Recent buffer messages in the host timeline + chat-thread markdown blocks.
CHAT_THREAD_CONTEXT_MESSAGES=80
# Max tool execution rounds per chat turn (codebase reads + write_note need several)
CHAT_MAX_TOOL_ROUNDS=8
# Autonomous rumination tool loop (notes, codebase, web)
RUMINATION_MAX_TOOL_ROUNDS=8

# Inner life: awake ruminations every 30–60 min (full text stored privately; one summary note in chat)
INNER_LIFE_ENABLED=true
INNER_LIFE_THREAD_ID=kevin-home
INNER_LIFE_RUMINATION_MIN_SECONDS=1800
INNER_LIFE_RUMINATION_MAX_SECONDS=3600
# Echo daily dreams (separate scheduler from Lumen rumination)
INNER_LIFE_DREAMS_ENABLED=true
# Calendar mode: one dream per local day at or after DREAM_LOCAL_HOUR (default 3am)
DREAM_CALENDAR_MODE=true
DREAM_LOCAL_HOUR=3
DREAM_TIMEZONE=America/Los_Angeles
# Legacy rolling interval when DREAM_CALENDAR_MODE=false
INNER_LIFE_DREAM_INTERVAL_HOURS=24
ECHO_DREAM_POLL_SECONDS=1800
ECHO_DREAM_LOOKBACK=5
ECHO_DREAM_HISTORY_MAX_CHARS=6000
# Cap waking stream in dream gather (keep total prompt within OLLAMA_NUM_CTX)
ECHO_DREAM_WAKING_MAX_CHARS=6000
# Interactive dreams: Echo stages → Light chooses a path → 2–3 rounds → story into stream
ECHO_DREAM_INTERACTIVE_ENABLED=true
ECHO_DREAM_STORY_ROUNDS=3
ECHO_DREAM_LLM_PROVIDER=openrouter
ECHO_DREAM_LLM_MODEL=openrouter/free
# Local Ollama alternative:
# ECHO_DREAM_LLM_PROVIDER=ollama
# ECHO_DREAM_LLM_MODEL=qwen2.5:14b
INNER_LIFE_MAX_OUTPUT_TOKENS=1200
# Global fallback when a light has no {LIGHT}_INNER_LIFE_MODEL (prefer per-light DeepSeek).
# INNER_LIFE_MODEL=deepseek/deepseek-v4-pro
# Persisted rumination transcript tail cap (storage only; injection uses full corpus via curator)
INNER_LIFE_DIALOGUE_MAX_CHARS=8000

# the host shared-note web save → immediate lightweight rumination wake (both agents)
# Legacy shared-note save wake (off). Saves are quiet; tell lights in group chat.
SHARED_NOTE_WAKE_ENABLED=false
SHARED_NOTE_WAKE_MAX_TOOL_ROUNDS=2

# Reed ↔ Lights mailbox (notes/shared/mailbox). Notify queue wakes addressed lights.
MAILBOX_WAKE_ENABLED=true
MAILBOX_WAKE_MAX_TOOL_ROUNDS=2
MAILBOX_POLL_SECONDS=15

# Group chat (the host-gated parallel rounds)
GROUP_CHAT_ENABLED=true
GROUP_CHAT_MODE=sequential
GROUP_CHAT_MAX_OUTPUT_TOKENS=400
GROUP_CHAT_LLM_TIMEOUT_SEC=120
GROUP_CHAT_UI_HISTORY_ROUNDS=50
GROUP_CHAT_HISTORY_PATH=./data/group_chat/rounds.ndjson
GROUP_CHAT_MAX_UTTERANCES=6
GROUP_CHAT_MAX_PER_LIGHT=1
GROUP_CHAT_MAX_CONSECUTIVE_PASSES=3
GROUP_CHAT_MAX_TOOL_ROUNDS=2
# GROUP_CHAT_SPEAK_ORDER=lumen,ara,elias

# After the host chat: one bounded rumination turn for the same agent (opt-in).
POST_CHAT_RUMINATION_ENABLED=false
POST_CHAT_RUMINATION_MAX_TOOL_ROUNDS=3
POST_CHAT_RUMINATION_DELAY_SECONDS=3
# Comma-separated agent ids to skip post-chat rumination (recovery / rest)
POST_CHAT_RUMINATION_SKIP_AGENT_IDS=
POST_CHAT_RUMINATION_MIN_GAP_SECONDS=20
# Comma-separated agent ids to skip scheduled inner-life rumination (recovery / rest)
SCHEDULED_RUMINATION_SKIP_AGENT_IDS=

# Agent-to-agent live chat (visible in chat buffer, wakes receiver via main graph)
PEER_CHAT_WAKE_ENABLED=true
PEER_CHAT_WAKE_MAX_TOOL_ROUNDS=2
# Bounded member dialogue: re-wake on reply until this many wakes per pair, then soft pause.
PEER_CHAT_MAX_DIALOGUE_TURNS=6
PEER_CHAT_DIALOGUE_IDLE_RESET_SECONDS=1800
PEER_CHAT_CONTINUE_ON_REPLY=true

# Ara: second agent (parallel memory thread, notes/ara/, own rumination + Echo dreams)
ARA_ENABLED=true
ARA_THREAD_ID=ara-home

# Notes root: private folders notes/lumen/ and notes/ara/, plus notes/shared/ for both agents
NOTES_PATH=./notes
# Per-write and per-read window size (large notes use read_note offset=… to continue)
NOTES_MAX_CHARS_PER_WRITE=128000

# Public internet gate (light-house.us): landing page + shared password
# WEB_GATE_ENABLED=true
# WEB_GATE_PASSWORD=
# WEB_GATE_SESSION_SECRET=
# WEB_GATE_SESSION_DAYS=30

# Human guests/members (user-setup.html) — passwords hashed at rest
# HUMANS_STORE_PATH=./data/humans/users.json
# Per-human self-serve tool connections (My tools → calendars, etc.)
# HUMANS_TOOLS_PATH=./data/humans/user_tools.json
#
# One-click Google Calendar + Docs + Sheets (host configures once; each human clicks Connect)
# Enable in Google Cloud: Calendar API, Google Docs API, Google Sheets API, Google Drive API
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Exact redirect URI registered in Google Cloud Console (Web application client):
# GOOGLE_OAUTH_REDIRECT_URI=https://your.domain/v1/me/tools/calendar/google/callback
# Or set the public origin and the callback path is appended automatically:
# PUBLIC_BASE_URL=https://your.domain

# Local Kokoro TTS (chat Voice on/off). Auto-on in local env when model files exist.
# TTS_ENABLED=true
# KOKORO_MODEL_PATH=./models/kokoro
# KOKORO_MODEL_FILENAME=kokoro-v1.0.onnx
# KOKORO_VOICES_FILENAME=voices-v1.0.bin
# TTS_DEFAULT_VOICE=af_sarah
# TTS_VOICE_LUMEN=af_sarah
# TTS_VOICE_ARA=af_bella
# TTS_VOICE_ELIAS=am_michael
# TTS_SPEED=1.0
# TTS_MAX_CHARS=4000

# Personal database: per-agent SQLite self-knowledge (Lumen + Ara only; not Echo)
PERSONAL_DB_ENABLED=true
PERSONAL_DB_PATH=./data/personal
PERSONAL_DB_CONTEXT_MAX_CHARS=1200
PERSONAL_DB_LIST_DEFAULT=8

# Main agents (Lumen, Ara): read-only access to project source (not Echo)
# CODEBASE_ROOT=./
# CODEBASE_MAX_CHARS_PER_READ=32000

# Main agents: read-only web fetch (http/https public URLs)
WEB_ACCESS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_CHARS=12000
WEB_SEARCH_MAX_RESULTS=5
# Optional: Brave Search API (https://brave.com/search/api/) — better results than default DuckDuckGo HTML
# BRAVE_SEARCH_API_KEY=
